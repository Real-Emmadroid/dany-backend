# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (Neon or standard Postgres)
# e.g., postgresql://neondb_owner:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-name.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens (min 32 chars recommended)
JWT_SECRET="smart-inventory-jwt-secret-key-32-chars-long"

# PORT: Server port (defaults to 3000)
PORT="3000"
